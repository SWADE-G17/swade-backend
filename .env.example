# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET_NAME=mri-files
MINIO_HEATMAP_BUCKET=heatmaps
MINIO_REPORT_BUCKET=reports

# Supabase Postgres (Session Pooler)
# Get from: Supabase Dashboard > Settings > Database > Connection string > Session Pooler
# Convert to JDBC: jdbc:postgresql://<host>:<port>/<db>?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=your-database-password

# Supabase JWT (ES256 via JWKS)
# Get project ref from: Supabase Dashboard > Settings > General
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
